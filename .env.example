# Copie para .env e ajuste.
# DB_DATABASE/DB_USERNAME/DB_PASSWORD alimentam o docker-compose (mysql e backend)
# via interpolação ${VAR:-default}. FRONTEND_URL e GOOGLE_CLIENT_ID/SECRET não são
# lidos pelo compose — configure-os diretamente em backend/.env.
DB_DATABASE=lifeboard
DB_USERNAME=root
DB_PASSWORD=root
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
