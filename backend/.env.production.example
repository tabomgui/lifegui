# Template do backend/.env de produção. O install.sh troca os __PLACEHOLDERS__.
APP_NAME=lifegui
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=__APP_URL__
FRONTEND_URL=__APP_URL__

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lifegui
DB_USERNAME=root
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=__SESSION_DOMAIN__
SESSION_SECURE_COOKIE=__SECURE_COOKIE__
SANCTUM_STATEFUL_DOMAINS=__STATEFUL_DOMAINS__

# Cadastro público depois da primeira conta (criada em /setup).
REGISTRATION_ENABLED=false

# Raiz dos vaults do Cérebro dentro do container (montada do host em ./vaults).
# Precisa estar aqui: o artisan serve não enxerga o environment do compose.
VAULTS_PATH=/vaults

# Login Google e Google Calendar (opcional). Veja o README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=__APP_URL__/api/auth/google/callback

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
